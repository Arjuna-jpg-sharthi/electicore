SECRET_KEY=replace-with-a-random-32-character-or-longer-value
JWT_SECRET_KEY=replace-with-a-different-random-32-character-or-longer-value
FLASK_DEBUG=0
APP_ENV=production
MAX_UPLOAD_BYTES=15728640
# For a persistent hosting disk, point both values below to that mounted path.
# DATABASE_URL=sqlite:////var/data/electicore.db
# UPLOAD_DIR=/var/data/uploads
# Configure these only with institution-approved SMTP credentials.
# ANTI_RAGGING_EMAIL=anti-ragging@college.edu
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_FROM=electicore@college.edu
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
# DATABASE_URL=sqlite:///electicore.db
# Optional AI drafting. Reports still work with a secure template when this is unset.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
